rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 사용자 컬렉션: 본인 데이터 읽기/쓰기 가능
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // 플래시카드 서브컬렉션
      match /flashcards/{date} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // 탈퇴한 사용자 기록 (재가입 방지용)
    match /deletedUsers/{userId} {
      allow read, create: if request.auth != null && request.auth.uid == userId;
    }
    
    // GitHub Trending 캐시: 랜딩 데모는 비로그인 방문자도 읽어야 하므로 공개 읽기
    // 쓰기는 Cloud Functions의 Admin SDK만 수행하므로 규칙에서 허용하지 않음
    match /meta/trendingRepos {
      allow read: if true;
    }

    // 랜딩 데모 사전 생성 카드: 트렌딩 목록과 같은 이유로 비로그인 방문자도 읽어야 함
    // 쓰기는 스케줄러(refreshTrendingRepos)의 Admin SDK만 수행하므로 규칙에서 허용하지 않음
    match /demoFlashcards/{cacheId} {
      allow read: if true;
    }

    // 공지사항: 읽기 전용 (쓰기는 Firebase Console에서만)
    match /notices/{noticeId} {
      allow read: if request.auth != null;
    }
  }
}

